generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The single Clover Kiss Cinema posting account. Credentials live in
// environment variables, not in this table (appPassword is a placeholder).
model Account {
  id          Int      @id @default(autoincrement())
  label       String
  handle      String   @unique
  did         String   @unique
  appPassword String
  createdAt   DateTime @default(now())
  posts       Post[]
}

// People allowed to log in. role: "admin" | "member"
model User {
  id          Int       @id @default(autoincrement())
  did         String    @unique
  handle      String
  displayName String?
  avatar      String?
  role        String    @default("member")
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  sessions    Session[]
  submitted   Post[]    @relation("PostSubmitter")
  reviewed    Post[]    @relation("PostReviewer")
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Key/value storage for the atproto OAuth client (JSON strings).
model OAuthState {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

model OAuthSession {
  key   String @id
  value String
}

model Post {
  id            Int       @id @default(autoincrement())
  accountId     Int
  account       Account   @relation(fields: [accountId], references: [id])
  // draft | pending | scheduled | sent | failed | rejected
  status        String    @default("draft")
  scheduledAt   DateTime?
  sentAt        DateTime?
  errorMsg      String?
  submittedById Int?
  submittedBy   User?     @relation("PostSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById  Int?
  reviewedBy    User?     @relation("PostReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  threads       Thread[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Thread {
  id       Int     @id @default(autoincrement())
  postId   Int
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  position Int
  text     String
  images   Image[]
}

model Image {
  id       Int    @id @default(autoincrement())
  threadId Int
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  path     String
  altText  String @default("")
  position Int
}

model Template {
  id        Int      @id @default(autoincrement())
  name      String
  threads   String
  createdAt DateTime @default(now())
}
