# ── Storage (Railway volume mounted at /data) ──
DATABASE_URL=file:/data/db/skyqueue.db
UPLOAD_DIR=/data/uploads
PORT=3000

# ── Where the app lives (no trailing slash). Must be https in production,
#    because Bluesky OAuth redirects back to it. ──
BASE_URL=https://scheduler.cloverkisscinema.club

# ── The one account posts are sent from ──
CKC_HANDLE=cloverkisscinema.club
# Create at https://bsky.app/settings/app-passwords (while signed in as that account)
CKC_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── The manager (can approve posts and manage the guest list) ──
ADMIN_HANDLE=professorkiosk.wtf

# ── Bluesky OAuth signing key: run `node scripts/generate-oauth-key.js`
#    and paste the single line of output here. Keep it secret. ──
OAUTH_PRIVATE_KEY_JWK=

# ── Local development only (ignored unless BASE_URL is http://localhost...) ──
# DEV_BYPASS_ROLE=admin
